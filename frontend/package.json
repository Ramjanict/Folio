{
  "name": "folio",
  "description": "Folio web app. Readers browse and borrow books, authors submit manuscripts, and admins publish titles and manage loans.",
  "keywords": [
    "folio",
    "library",
    "book-management",
    "lending",
    "react",
    "typescript",
    "tailwindcss",
    "redux"
  ],
  "author": "Ramjan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node api.js && npm run dev",
    "dev": "node api.js && vite --port 3000",
    "build": "node api.js && tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.1",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.7.3",
    "vite": "^5.4.8"
  }
}
